    {
      "id": "b+tree",
      "workdir": "b+tree",
      "executable": "b+tree.out",
      "build": [["make", "-B", "b+tree.out", "C_C=gcc", "OMP_LIB=-lgomp", "OMP_FLAG=-fopenmp"]],
      "clean": [["make", "clean"]],
      "sources": ["main.c", "kernel/kernel_cpu.c", "kernel/kernel_cpu_2.c", "util/timer/timer.c", "util/num/num.c"],
      "include_dirs": ["."],
      "static_flags": ["-fopenmp"],
      "inputs": [
        {
          "id": "mil-smoke",
          "profile": "smoke",
          "args": ["core", "2", "file", "../../data/b+tree/mil.txt", "command", "../../data/b+tree/command.txt"],
          "threads": 2,
          "parameters": {"input_file": "mil.txt", "command_file": "command.txt", "threads": 2},
          "required_files": ["../../data/b+tree/mil.txt", "../../data/b+tree/command.txt"]
        },
        {
          "id": "mil-official",
          "profile": "official",
          "args": ["core", "4", "file", "../../data/b+tree/mil.txt", "command", "../../data/b+tree/command.txt"],
          "threads": 4,
          "parameters": {"input_file": "mil.txt", "command_file": "command.txt", "threads": 4},
          "required_files": ["../../data/b+tree/mil.txt", "../../data/b+tree/command.txt"]
